# ========================================================
# ENVIRONMENT VARIABLES TEMPLATE (LMS TERPADU)
# ========================================================

# Database PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=lms_db
# DATABASE_URL digunakan oleh aplikasi (role non-superuser lms_app untuk penegakan RLS)
DATABASE_URL="postgresql://lms_app:app_secure_password_123@127.0.0.1:5432/lms_db?schema=public"
# DIRECT_URL digunakan oleh Prisma Migrate & Admin superuser
DIRECT_URL="postgresql://postgres:postgres123@127.0.0.1:5432/lms_db?schema=public"

# Auth.js / NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-key-minimum-32-characters-long-for-lms-auth"

# Storage Configuration (local | s3)
STORAGE_DRIVER="local"
UPLOAD_DIR="./public/uploads"

# Optional S3 Settings (Produksi)
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION=""
