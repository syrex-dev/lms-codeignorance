# Database PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_superuser_password
POSTGRES_DB=lms_db
LMS_APP_DB_PASSWORD=your_lms_app_role_password
LMS_PLATFORM_DB_PASSWORD=your_lms_platform_role_password

# Application Connection String (Non-Superuser, NOBYPASSRLS)
DATABASE_URL="postgresql://lms_app:your_lms_app_role_password@127.0.0.1:5432/lms_db?schema=public"

# Migration & Seeding Connection String (Superuser/Direct)
DIRECT_URL="postgresql://postgres:your_postgres_superuser_password@127.0.0.1:5432/lms_db?schema=public"

# Platform Ops Connection String (BYPASSRLS)
PLATFORM_DATABASE_URL="postgresql://lms_platform:your_lms_platform_role_password@127.0.0.1:5432/lms_db?schema=public"

# Test Database Connection Strings
TEST_DATABASE_URL="postgresql://postgres:your_postgres_superuser_password@127.0.0.1:5432/lms_test?schema=public"
TEST_APP_DATABASE_URL="postgresql://lms_app:your_lms_app_role_password@127.0.0.1:5432/lms_test?schema=public"

# Auth.js / NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_32_characters_random_secret_here"

# Storage Configuration
STORAGE_DRIVER="local"
UPLOAD_DIR="./public/uploads"

# Development & Testing Flags
DEV_OTP_OUTBOX="true"
ALLOW_MOCK_CAPTCHA="false"
